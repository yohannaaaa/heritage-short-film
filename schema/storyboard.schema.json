{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "english_title",
    "language",
    "subtitle_language",
    "total_duration_seconds",
    "aspect_ratios",
    "visual_style",
    "narrative_perspective",
    "character_policy",
    "audio",
    "characters",
    "shots"
  ],
  "$defs": {
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "style"
      ],
      "properties": {
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "english_title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "Amharic"
    },
    "subtitle_language": {
      "const": "English"
    },
    "total_duration_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 90
    },
    "aspect_ratios": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "9:16",
          "16:9"
        ]
      }
    },
    "visual_style": {
      "type": "string",
      "minLength": 1
    },
    "narrative_perspective": {
      "type": "string",
      "minLength": 1
    },
    "character_policy": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tts_model",
        "narration",
        "speakers"
      ],
      "properties": {
        "tts_model": {
          "type": "string",
          "minLength": 1
        },
        "narration": {
          "$ref": "#/$defs/voice"
        },
        "speakers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/voice"
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scene",
          "duration_seconds",
          "shot_reason",
          "visual_prompt",
          "motion_prompt",
          "narration_am",
          "dialogue",
          "audio_cues",
          "music_cue",
          "continuity_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "scene": {
            "enum": [
              "childhood_memory",
              "passage_of_time",
              "present_day",
              "emotional_ending"
            ]
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "shot_reason": {
            "type": "string",
            "minLength": 10
          },
          "visual_prompt": {
            "type": "string",
            "minLength": 10
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 5
          },
          "narration_am": {
            "type": "string"
          },
          "narration_style": {
            "type": "string"
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker",
                "line"
              ],
              "properties": {
                "speaker": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "string",
                  "minLength": 1
                },
                "style": {
                  "type": "string"
                }
              }
            }
          },
          "audio_cues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "music_cue": {
            "type": "string",
            "minLength": 1
          },
          "continuity_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_model",
        "size",
        "reference_size",
        "candidates",
        "base_seed",
        "daily_neuron_cap",
        "style_blocks",
        "common_suffix",
        "references",
        "shot_refs"
      ],
      "properties": {
        "image_model": {
          "type": "string"
        },
        "size": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 256,
              "maximum": 1920
            },
            "height": {
              "type": "integer",
              "minimum": 256,
              "maximum": 1920
            }
          }
        },
        "reference_size": {
          "type": "integer",
          "minimum": 256,
          "maximum": 512
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "base_seed": {
          "type": "integer"
        },
        "daily_neuron_cap": {
          "type": "integer",
          "minimum": 100
        },
        "style_blocks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "common_suffix": {
          "type": "string"
        },
        "references": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 10
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 3
              },
              "lock": {
                "type": "string"
              }
            }
          }
        },
        "shot_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          }
        },
        "same_seed": {
          "type": "boolean"
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          }
        }
      }
    }
  }
}